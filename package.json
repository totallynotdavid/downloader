{
  "name": "@totallynotdavid/downloader",
  "version": "1.1.0",
  "author": "David Duran <dadch1404@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totallynotdavid/downloader.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && bun x bunup",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "eval": "bun scripts/eval.ts",
    "eval:live": "bun scripts/eval.ts --live instagram",
    "fix": "bun x biome check --write . && oxfmt '**/*.md' '**/*.yml'",
    "lint": "bun x biome check . && oxfmt --check '**/*.md' '**/*.yml'",
    "record": "bun --env-file=.env scripts/record.ts",
    "release": "bun run check && npm publish",
    "test": "bun test tests/replay",
    "test:coverage": "bun test tests/replay --coverage --coverage-reporter=lcov",
    "test:update": "bun test tests/replay --update-snapshots",
    "typecheck": "bun x tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "bunup": "^0.16.32",
    "typescript": "7.0.2"
  },
  "bugs": {
    "url": "https://github.com/totallynotdavid/downloader/issues"
  },
  "description": "Get direct download URLs from YouTube, Instagram, TikTok, X, and more.",
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/totallynotdavid/downloader#readme",
  "keywords": [
    "imgur",
    "reddit",
    "instagram",
    "facebook",
    "twitter",
    "pinterest",
    "tiktok",
    "downloader"
  ],
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.ts"
}
