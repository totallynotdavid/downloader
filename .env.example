# Copy to .env and fill in. The record script loads it.

# Recording proxy URL. "direct" records without a proxy.
EVAL_PROXY_URL=

# Geonode residential gateway. Recording uses it when EVAL_PROXY_URL is
# empty or unset.
GEONODE_USERNAME=
GEONODE_PASSWORD=

# Directory the tests read and write cassettes in. Leave it unset to use
# tests/cassettes.
# EVAL_CASSETTES=
